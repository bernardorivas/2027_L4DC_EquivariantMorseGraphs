{
  "experiment": "joint-interval-v1",
  "seed": 20261112,
  "splits": {
    "train": 16384,
    "validation": 4096,
    "test": 4096
  },
  "times": [
    0,
    1,
    10
  ],
  "state_order": [
    "x",
    "y",
    "z"
  ],
  "fields": {
    "p0,p1,p10": "physical states, shape (count, 3)",
    "w0,w1,w10": "log latitude arctanh(z), shape (count,)"
  },
  "initial_distribution": {
    "uniform_sphere_fraction": 0.75,
    "polar_fraction": 0.25,
    "polar_distance_log10_range": [
      -10,
      -2
    ]
  },
  "flow": {
    "height_rhs": "z*(0.16-z*z)*(1-z*z)",
    "longitude_rate": 0.6
  },
  "integration": {
    "variable": "w=arctanh(z)",
    "rhs": "tanh(w)*(0.16-tanh(w)**2)",
    "method": "DOP853",
    "rtol": 2e-13,
    "atol": 2e-14
  },
  "training_pairs": [
    "train_p0",
    "train_p1"
  ],
  "training_auxiliary_fields": [
    "train_w0",
    "train_w1"
  ],
  "time_ten_use": "held-out rollout diagnostics, not the training objective",
