import LatentEquivariant.Dynamics.Basic

/-!
# Orbit spaces of equivariant maps

Let a group `G` act on `X` and let `f : X → X` be equivariant. Then `f` induces
`f/G : X/G → X/G` with `π ∘ f = (f/G) ∘ π`, where `π` is the orbit map. This file proves:

* `Inv_quotientMap`: for a `G`-invariant set `K`, `Inv(π(K), f/G) = π(Inv(K, f))`. The inclusion
  `⊆` lifts solutions of `f/G` to solutions of `f`, choosing preimages within orbits.
* `IsIndexPair.image_orbitMap`: a `G`-invariant index pair `(N, L)` for `f` gives the index pair
  `(π(N), π(L))` for `f/G`, as stated in Section `sec:conley-symmetry`.

The proof uses no finiteness or compactness of `G`, only that each `g` acts by a homeomorphism.
This generality comes from `IsIndexPair` being defined on any topological space, while Szymczak's
index pairs live in metric spaces. The image pair is an index pair in Szymczak's sense when `X/G`
is metrizable, for instance for a compact group, in particular a finite one, acting continuously
on a metric space. For other groups `X/G` need not be Hausdorff: for the group generated by an
irrational rotation of `S²` it is not even `T₀`. A proper action of a noncompact group has no
nonempty compact invariant set, so there the statement is vacuous.

All statements are for maps, as computed by CMGDB.
-/

namespace LatentEquivariant

open Set Topology Pointwise MulAction

variable {G X Y : Type*} [Group G] [MulAction G X] [MulAction G Y]

/-- `A` is invariant under `G`. -/
def IsGInvariant (G : Type*) [Group G] [MulAction G X] (A : Set X) : Prop :=
  ∀ (g : G), ∀ x ∈ A, g • x ∈ A

/-- `φ` is `G`-equivariant. -/
def IsEquivariant (G : Type*) [Group G] [MulAction G X] [MulAction G Y] (φ : X → Y) : Prop :=
  ∀ (g : G) (x : X), φ (g • x) = g • φ x

/-- The orbit map `π : X → X/G`. -/
abbrev orbitMap (G X : Type*) [Group G] [MulAction G X] : X → orbitRel.Quotient G X :=
  Quotient.mk''

section Orbit

variable {A B : Set X}

theorem orbitMap_eq_iff {a b : X} :
    orbitMap G X a = orbitMap G X b ↔ ∃ g : G, g • b = a := by
  rw [Quotient.eq'', orbitRel_apply, mem_orbit_iff]

@[simp] theorem orbitMap_smul (g : G) (x : X) : orbitMap G X (g • x) = orbitMap G X x :=
  orbitMap_eq_iff.mpr ⟨g, rfl⟩

theorem orbitMap_surjective : Function.Surjective (orbitMap G X) :=
  fun q ↦ Quotient.inductionOn' q fun x ↦ ⟨x, rfl⟩

theorem IsGInvariant.smul_set_eq (hA : IsGInvariant G A) (g : G) : g • A = A := by
  apply Subset.antisymm
  · rintro _ ⟨a, ha, rfl⟩
    exact hA g a ha
  · intro a ha
    exact ⟨g⁻¹ • a, hA g⁻¹ a ha, smul_inv_smul g a⟩

theorem IsGInvariant.diff (hA : IsGInvariant G A) (hB : IsGInvariant G B) :
    IsGInvariant G (A \ B) := by
  intro g x ⟨hxA, hxB⟩
  refine ⟨hA g x hxA, fun h ↦ hxB ?_⟩
  simpa using hB g⁻¹ _ h

theorem IsGInvariant.preimage {φ : X → Y} (hφ : IsEquivariant G φ) {C : Set Y}
    (hC : IsGInvariant G C) : IsGInvariant G (φ ⁻¹' C) := by
  intro g x hx
  rw [mem_preimage, hφ]
  exact hC g _ hx

theorem IsGInvariant.image {φ : X → Y} (hφ : IsEquivariant G φ) (hA : IsGInvariant G A) :
    IsGInvariant G (φ '' A) := by
  rintro g _ ⟨a, ha, rfl⟩
  exact ⟨g • a, hA g a ha, hφ g a⟩

/-- A `G`-invariant set is saturated: `π⁻¹(π(A)) = A`. -/
theorem IsGInvariant.preimage_image_orbitMap (hA : IsGInvariant G A) :
    orbitMap G X ⁻¹' (orbitMap G X '' A) = A := by
  ext y
  constructor
  · rintro ⟨a, ha, hay⟩
    obtain ⟨g, hg⟩ := orbitMap_eq_iff.mp hay
    have := hA g⁻¹ a ha
    rwa [← hg, inv_smul_smul] at this
  · intro hy
    exact ⟨y, hy, rfl⟩

/-- `π(A \ B) = π(A) \ π(B)` when `B` is `G`-invariant. -/
theorem IsGInvariant.image_diff (hB : IsGInvariant G B) (A : Set X) :
    orbitMap G X '' (A \ B) = orbitMap G X '' A \ orbitMap G X '' B := by
  apply Subset.antisymm
  · rintro _ ⟨x, ⟨hxA, hxB⟩, rfl⟩
    refine ⟨mem_image_of_mem _ hxA, fun h ↦ hxB ?_⟩
    rw [← hB.preimage_image_orbitMap]
    exact h
  · rintro _ ⟨⟨x, hxA, rfl⟩, hxB⟩
    exact ⟨x, ⟨hxA, fun h ↦ hxB (mem_image_of_mem _ h)⟩, rfl⟩

variable [TopologicalSpace X]

theorem continuous_orbitMap : Continuous (orbitMap G X) :=
  continuous_quotient_mk'

variable [ContinuousConstSMul G X]

theorem isOpenMap_orbitMap : IsOpenMap (orbitMap G X) :=
  isOpenMap_quotient_mk'_mul

theorem IsGInvariant.interior (hA : IsGInvariant G A) : IsGInvariant G (interior A) := by
  intro g x hx
  rw [← hA.smul_set_eq g, interior_smul]
  exact smul_mem_smul_set hx

theorem IsGInvariant.closure (hA : IsGInvariant G A) : IsGInvariant G (closure A) := by
  intro g x hx
  rw [← hA.smul_set_eq g, closure_smul]
  exact smul_mem_smul_set hx

/-- `π(int A) = int π(A)` for a `G`-invariant set `A`. -/
theorem IsGInvariant.image_interior (hA : IsGInvariant G A) :
    orbitMap G X '' _root_.interior A = _root_.interior (orbitMap G X '' A) := by
  apply Subset.antisymm (isOpenMap_orbitMap.image_interior_subset A)
  intro y hy
  obtain ⟨x, rfl⟩ := orbitMap_surjective y
  refine ⟨x, ?_, rfl⟩
  have hU : IsOpen (orbitMap G X ⁻¹' _root_.interior (orbitMap G X '' A)) :=
    isOpen_interior.preimage continuous_orbitMap
  have hUA : orbitMap G X ⁻¹' _root_.interior (orbitMap G X '' A) ⊆ A := fun x hx ↦ by
    have hx' : orbitMap G X x ∈ orbitMap G X '' A := interior_subset hx
    have hx'' : x ∈ orbitMap G X ⁻¹' (orbitMap G X '' A) := hx'
    rwa [hA.preimage_image_orbitMap] at hx''
  exact interior_maximal hUA hU hy

/-- `π(cl A) = cl π(A)` for a `G`-invariant set `A`. -/
theorem IsGInvariant.image_closure (hA : IsGInvariant G A) :
    orbitMap G X '' _root_.closure A = _root_.closure (orbitMap G X '' A) := by
  apply Subset.antisymm (image_closure_subset_closure_image continuous_orbitMap)
  apply closure_minimal (image_mono subset_closure)
  have hpre : IsClosed (orbitMap G X ⁻¹' (orbitMap G X '' _root_.closure A)) := by
    rw [hA.closure.preimage_image_orbitMap]
    exact isClosed_closure
  exact (isQuotientMap_quotient_mk' (s := orbitRel G X)).isCoinducing.isClosed_preimage.mp hpre

end Orbit

section QuotientMap

variable {f : X → X}

/-- The map `f/G` induced on `X/G` by an equivariant map `f`. -/
def quotientMap (f : X → X) (hf : IsEquivariant G f) :
    orbitRel.Quotient G X → orbitRel.Quotient G X :=
  Quotient.map' f fun a b hab ↦ by
    rw [orbitRel_apply, mem_orbit_iff] at hab ⊢
    obtain ⟨g, rfl⟩ := hab
    exact ⟨g, (hf g b).symm⟩

/-- The orbit map semiconjugates `f` to `f/G`. -/
@[simp] theorem quotientMap_orbitMap (hf : IsEquivariant G f) (x : X) :
    quotientMap f hf (orbitMap G X x) = orbitMap G X (f x) :=
  rfl

theorem image_quotientMap_image (hf : IsEquivariant G f) (N : Set X) :
    quotientMap f hf '' (orbitMap G X '' N) = orbitMap G X '' (f '' N) := by
  simp only [image_image, quotientMap_orbitMap]

theorem continuous_quotientMap [TopologicalSpace X] (hf : IsEquivariant G f)
    (hfc : Continuous f) : Continuous (quotientMap f hf) :=
  hfc.quotient_map' _

/-- One step back: if `(f/G)(q) = π(y)`, then `q = π(y')` for some `y'` with `f(y') = y`. -/
theorem quotientMap_back_lift (hf : IsEquivariant G f) (y : X) (q : orbitRel.Quotient G X)
    (hq : quotientMap f hf q = orbitMap G X y) : ∃ y', f y' = y ∧ orbitMap G X y' = q := by
  obtain ⟨z, rfl⟩ := orbitMap_surjective q
  rw [quotientMap_orbitMap] at hq
  obtain ⟨g, hg⟩ := orbitMap_eq_iff.mp hq
  refine ⟨g⁻¹ • z, ?_, orbitMap_smul _ _⟩
  rw [hf, ← hg, inv_smul_smul]

/-- Solutions in the orbit space lift: `Inv(π(K), f/G) = π(Inv(K, f))` for `G`-invariant `K`
(Section `sec:conley-symmetry`). -/
theorem Inv_quotientMap (hf : IsEquivariant G f) {K : Set X} (hK : IsGInvariant G K) :
    Inv (quotientMap f hf) (orbitMap G X '' K) = orbitMap G X '' Inv f K := by
  apply Subset.antisymm
  · rintro _ ⟨γ, hγ, rfl, hγK⟩
    obtain ⟨δ, hδ, hpδ⟩ := exists_solution_lift (p := orbitMap G X)
      (fun x ↦ (quotientMap_orbitMap hf x).symm) orbitMap_surjective (quotientMap_back_lift hf) hγ
    refine ⟨δ 0, ⟨δ, hδ, rfl, fun n ↦ ?_⟩, hpδ 0⟩
    have : δ n ∈ orbitMap G X ⁻¹' (orbitMap G X '' K) := by
      rw [mem_preimage, hpδ n]
      exact hγK n
    rwa [hK.preimage_image_orbitMap] at this
  · exact image_Inv_subset (fun x ↦ (quotientMap_orbitMap hf x).symm) K

/-- A `G`-invariant index pair `(N, L)` for `f` gives an index pair `(π(N), π(L))` for `f/G`
(Section `sec:conley-symmetry`). It is an index pair in
Szymczak's sense when `X/G` is metrizable; see the module docstring. -/
theorem IsIndexPair.image_orbitMap [TopologicalSpace X] [ContinuousConstSMul G X]
    (hf : IsEquivariant G f) {N L : Set X} (hN : IsGInvariant G N) (hL : IsGInvariant G L)
    (h : IsIndexPair f N L) :
    IsIndexPair (quotientMap f hf) (orbitMap G X '' N) (orbitMap G X '' L) where
  isCompact_left := h.isCompact_left.image continuous_orbitMap
  isCompact_right := h.isCompact_right.image continuous_orbitMap
  isolating := by
    have hNL : IsGInvariant G (N \ L) := hN.diff hL
    rw [← hL.image_diff, ← hNL.image_closure, Inv_quotientMap hf hNL.closure,
      ← hNL.image_interior]
    exact image_mono h.isolating
  posInv := by
    rintro _ ⟨x, hx, rfl⟩ hfx
    rw [quotientMap_orbitMap, ← hL.image_diff] at hfx
    have hfx' : f x ∈ N \ L := by
      rw [← (hN.diff hL).preimage_image_orbitMap]
      exact hfx
    exact h.posInv x hx hfx'
  exit := by
    rintro _ ⟨x, hx, rfl⟩ hfx
    rw [quotientMap_orbitMap] at hfx
    exact ⟨x, h.exit x hx fun hfxN ↦ hfx ⟨f x, hfxN, rfl⟩, rfl⟩

end QuotientMap

end LatentEquivariant

namespace LatentEquivariant

open Set Topology Pointwise MulAction

section QuotientSetMap

variable {G X Y : Type*} [Group G] [MulAction G X] [MulAction G Y]

theorem image_orbitMap_smul (g : G) (A : Set X) :
    orbitMap G X '' (g • A) = orbitMap G X '' A := by
  change orbitMap G X '' ((fun x ↦ g • x) '' A) = _
  rw [image_image]
  simp only [orbitMap_smul]

/-- The quotient of an equivariant set-valued map. -/
def quotientSetMap (φ : X → Set Y) (hφ : IsEquivariant G φ) :
    orbitRel.Quotient G X → Set (orbitRel.Quotient G Y) :=
  Quotient.lift (fun x ↦ orbitMap G Y '' φ x) fun a b hab ↦ by
    obtain ⟨g, hg⟩ := (orbitMap_eq_iff (G := G)).mp (Quotient.sound hab)
    rw [← hg, hφ, image_orbitMap_smul]

@[simp] theorem quotientSetMap_orbitMap (φ : X → Set Y) (hφ : IsEquivariant G φ) (x : X) :
    quotientSetMap φ hφ (orbitMap G X x) = orbitMap G Y '' φ x := rfl

end QuotientSetMap

section InvariantSublattice

variable {G X : Type*} [Group G] [MulAction G X] {N M : Set X}

theorem isGInvariant_empty : IsGInvariant G (∅ : Set X) := by
  intro g x hx
  exact hx.elim

theorem IsGInvariant.union (hN : IsGInvariant G N) (hM : IsGInvariant G M) :
    IsGInvariant G (N ∪ M) := by
  intro g x hx
  exact hx.elim (fun h ↦ Or.inl (hN g x h)) (fun h ↦ Or.inr (hM g x h))

theorem IsGInvariant.inter (hN : IsGInvariant G N) (hM : IsGInvariant G M) :
    IsGInvariant G (N ∩ M) := by
  intro g x hx
  exact ⟨hN g x hx.1, hM g x hx.2⟩

/-- The sublattice of invariant subsets. -/
def invariantSetSublattice (G X : Type*) [Group G] [MulAction G X] : Sublattice (Set X) where
  carrier := {N | IsGInvariant G N}
  supClosed' := fun _ hN _ hM ↦ hN.union hM
  infClosed' := fun _ hN _ hM ↦ hN.inter hM

theorem generatedSublattice_invariant {S : Set (Set X)}
    (hS : ∀ N ∈ S, IsGInvariant G N) : generatedSublattice S ≤ invariantSetSublattice G X :=
  generatedSublattice_le hS

end InvariantSublattice

end LatentEquivariant

namespace LatentEquivariant

open Set

section InvariantSolutions

variable {G X : Type*} [Group G] [MulAction G X] {f : X → X} {N : Set X}

theorem IsGInvariant.Inv (hN : IsGInvariant G N) (hf : IsEquivariant G f) :
    IsGInvariant G (Inv f N) := by
  rintro g x ⟨γ, hγ, hγ0, hγN⟩
  refine ⟨fun n ↦ g • γ n, ?_, congrArg (g • ·) hγ0, fun n ↦ hN g _ (hγN n)⟩
  intro n
  rw [hf, hγ n]

end InvariantSolutions

end LatentEquivariant
